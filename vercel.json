{
  "version": 2,
  "installCommand": "cd mumbai-smart-civic/frontend && npm install",
  "buildCommand": "cd mumbai-smart-civic/frontend && npm run build",
  "outputDirectory": "mumbai-smart-civic/frontend/dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
